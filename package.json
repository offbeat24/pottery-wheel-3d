{
  "name": "pottery-wheel-3d",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run tests",
    "test:e2e": "playwright test",
    "bass": "bass",
    "check:agents": "bass doctor",
    "verify": "npm run check:agents && npm run typecheck && npm test && npm run test:e2e && npm run build",
    "setup:agent": "node scripts/agent-bootstrap.mjs"
  },
  "dependencies": {
    "three": "^0.179.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^20.19.43",
    "@types/three": "^0.179.0",
    "bass-platform": "file:tools/bass-platform-0.2.1.tgz",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "vitest": "^3.2.4"
  }
}
